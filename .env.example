# Camoufox MCP — environment configuration
# Copy this file to .env and adjust as needed.
# All variables are optional; defaults are shown.

# ── Browser ──────────────────────────────────────────────────────────────────
CAMOUFOX_HEADLESS=true
CAMOUFOX_HUMANIZE=false

# ── Paths ────────────────────────────────────────────────────────────────────
CAMOUFOX_PROFILE_DIR=./data/profiles
CAMOUFOX_DOWNLOAD_DIR=./data/downloads
CAMOUFOX_SCREENSHOT_DIR=./data/screenshots

# ── Session limits ────────────────────────────────────────────────────────────
CAMOUFOX_MAX_SESSIONS=5
CAMOUFOX_SESSION_TIMEOUT=3600

# ── Timeouts (milliseconds) ───────────────────────────────────────────────────
CAMOUFOX_DEFAULT_TIMEOUT=30000
CAMOUFOX_NAVIGATION_TIMEOUT=30000

# ── Logging ───────────────────────────────────────────────────────────────────
# Choices: DEBUG | INFO | WARNING | ERROR | CRITICAL
CAMOUFOX_LOG_LEVEL=INFO
# Set to true to emit JSON log lines (useful for log aggregators / production)
CAMOUFOX_LOG_JSON=false

# ── Extraction limits ─────────────────────────────────────────────────────────
CAMOUFOX_MAX_TEXT_LENGTH=50000
CAMOUFOX_MAX_HTML_LENGTH=200000

# ── Screenshot ────────────────────────────────────────────────────────────────
CAMOUFOX_SCREENSHOT_QUALITY=80
